# Secreto compartido con el Worker de Cloudflare (mínimo 32 caracteres): openssl rand -hex 32
INGEST_SECRET=
# Cifra en la base de datos los secretos de webhooks y de 2 pasos: openssl rand -hex 32
# ¡Guárdala! Si se pierde, hay que volver a crear los secretos y el código de 2 pasos.
MASTER_KEY=
# La dirección del panel (cookies seguras, enlaces): https://pagoradar.tudominio.com
PUBLIC_URL=
# Dominio para las direcciones de recepción nuevas (se puede cambiar en Ajustes): pagos.tudominio.com
INBOUND_DOMAIN=
# Opcional: token para crear el primer administrador (si no, se imprime uno en los logs).
SETUP_TOKEN=
# Días que se guardan los pagos por defecto (se puede cambiar en Ajustes).
RETENTION_DAYS=180
# Solo para actualizar desde la primera versión: se importa una vez y luego se ignora.
PAGORADAR_SOURCES=[]
